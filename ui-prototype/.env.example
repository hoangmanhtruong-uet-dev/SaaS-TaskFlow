# Runtime identity
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Supabase (publishable key is safe for browser use; service-role and database credentials are server-only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_DB_URL=postgresql://postgres.project-ref:replace_me@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_JWT_SECRET=replace_me

# Google OAuth is configured in Supabase Dashboard; keep client secret server-side
GOOGLE_OAUTH_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace_me

# Resend
RESEND_API_KEY=re_replace_me
EMAIL_FROM=TaskFlow <onboarding@resend.dev>
EMAIL_REPLY_TO=support@example.com

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_PRICE_PRO_MONTHLY=price_replace_me

# Sentry (DSN is safe for browser use; auth token is build-only and server-side)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Scheduled jobs and administrative endpoints
CRON_SECRET=replace_with_32_or_more_random_characters

# Private attachment scanner. Required in production; endpoint returns {"clean":true} or {"clean":false,"signature":"..."}.
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=

# Production recovery gate. The restore timestamp must come from an isolated, verified rehearsal.
BACKUP_PROVIDER=
BACKUP_RETENTION_DAYS=
BACKUP_LAST_ISOLATED_RESTORE_AT=
