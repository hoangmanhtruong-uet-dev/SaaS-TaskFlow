{
  "name": "taskflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:db": "node scripts/verify-database.mjs",
    "test:security": "tsx --test tests/security/*.test.ts",
    "test:architecture": "tsx --test tests/architecture/*.test.ts",
    "test:security:database": "node scripts/audit-supabase-security.mjs",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test e2e/production-critical.spec.ts",
    "test:e2e:staging": "playwright test --config=playwright.config.ts",
    "test:e2e:staging:provision": "node scripts/run-staging-e2e.mjs",
    "env:check": "node scripts/validate-environment.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:backup": "node scripts/db-maintenance.mjs backup",
    "db:restore": "node scripts/db-maintenance.mjs restore",
    "db:rollback": "node scripts/db-maintenance.mjs rollback",
    "db:seed": "node scripts/db-maintenance.mjs seed",
    "stripe:configure": "node scripts/configure-stripe.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "postgres": "3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "^6.19.0",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
